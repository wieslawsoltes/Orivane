# Local defaults. Load with: node --env-file=.env server/index.js
# Never commit .env or place it in public/. Empty provider values mean disabled.
HOST=127.0.0.1
PORT=4173
DATA_DIR=./data
PUBLIC_ORIGIN=http://localhost:4173
ALLOWED_ORIGINS=
ALLOW_REGISTRATION=true
ALLOW_GUEST_ROOMS=true
METRICS_TOKEN=

# Optional shared storage. Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLUSTER_STORAGE_URL=
CLUSTER_SECRET=
CLUSTER_ALLOW_HTTP=false
CLUSTER_DB=./data/cluster.sqlite
STORAGE_HOST=127.0.0.1
STORAGE_PORT=4174

# OIDC: exact issuer, confidential client, callback /api/auth/oidc/callback.
# Use PUBLIC_ORIGIN=https://your-host before deploying behind TLS.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTH_METHOD=client_secret_post
OIDC_SCOPES=openid profile email
OIDC_EMAIL_DOMAINS=
OIDC_ALLOW_PRIVATE=false
SCIM_TOKEN=
SCIM_WORKSPACE_ID=

# AI_PROVIDER: openai-compatible OR ollama (see docs/INTEGRATIONS.md).
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_ALLOW_PRIVATE=false
GITHUB_TOKEN=
GITHUB_REPOSITORIES=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECTS=
SLACK_WEBHOOK_URL=
MIRO_ACCESS_TOKEN=
MIRO_BOARDS=
OUTGOING_WEBHOOK_URL=
OUTGOING_WEBHOOK_SECRET=

# compose.yaml serves only loopback HTTP; use host TLS proxy for public access.
ORIVANE_BIND=127.0.0.1
ORIVANE_PORT=4173
